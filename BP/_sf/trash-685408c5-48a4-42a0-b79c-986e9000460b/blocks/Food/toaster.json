{
	"format_version": "1.16.100",
	"minecraft:block": {
		"description": {
			"identifier": "cook:toaster",
			"is_experimental": false,
			"properties": {
				"cook:bread": [
					0,
					1,
					2,
					3,
					4,
					// 5 & 6 are knife 
					5,
					6
				]
			}
		},
		"permutations": [
			{
				"condition": "query.block_property('cook:bread') == 0",
				"components": {
					"minecraft:material_instances": {
						"*": {
							"texture": "cook_toaster",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": "geometry.toaster"
				}
			},
			{
				"condition": "query.block_property('cook:bread') == 1",
				"components": {
					"minecraft:material_instances": {
						"*": {
							"texture": "cook_toaster_bread",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": "geometry.toaster_bread_1"
				}
			},
			{
				"condition": "query.block_property('cook:bread') == 2",
				"components": {
					"minecraft:material_instances": {
						"*": {
							"texture": "cook_toaster_bread",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": "geometry.toaster_bread_2"
				}
			},
			{
				"condition": "query.block_property('cook:bread') == 3",
				"components": {
					"minecraft:material_instances": {
						"*": {
							"texture": "cook_toaster_bread",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": "geometry.toaster_bread_down"
				}
			},
			{
				"condition": "query.block_property('cook:knife_slot') == 5",
				"components": {
					"minecraft:material_instances": {
						"*": {
							"texture": "cook_toaster_knife",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": "geometry.toaster_knife"
				}
			},
			{
				"condition": "query.block_property('cook:knife_slot') == 6",
				"components": {
					"minecraft:material_instances": {
						"*": {
							"texture": "cook_toaster_knife",
							"render_method": "alpha_test"
						}
					},
					"minecraft:geometry": "geometry.toaster_knife_down"
				}
			}
		],
		"components": {
			"minecraft:geometry": "geometry.toaster",
			"minecraft:material_instances": {
				"*": {
					"texture": "cook_toaster",
					"render_method": "alpha_test"
				}
			},
			"minecraft:pick_collision": {
				"origin": [
					-6,
					0,
					-4
				],
				"size": [
					12,
					7,
					8
				]
			},
			"minecraft:entity_collision": {
				"origin": [
					-6,
					0,
					-4
				],
				"size": [
					12,
					7,
					8
				]
			},
			"minecraft:creative_category": {
				"category": "items"
			},
			"minecraft:block_light_absorption": 0,
			"bridge:rotate_y_on_place": {
				"flip": true
			},
			"minecraft:on_interact": {
				"event": "cook:ingredient"
			}
		},
		"events": {
			"cook:ingredient": {
				"sequence": [
					{
						"sequence": [
							{
								"condition": "query.is_item_name_any('slot.weapon.mainhand', 0, 'cook:bread_slice') && query.block_property('cook:bread') == 0",
								"set_block_property": {
									"cook:bread": 1
								}
							},
							{
								"condition": "query.is_item_name_any('slot.weapon.mainhand', 0, 'cook:bread_slice') && query.block_property('cook:bread') == 1",
								"set_block_property": {
									"cook:bread": 2
								}
							},
							{
								"condition": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'cook:bread_slice') && query.block_property('cook:bread') == 2",
								"set_block_property": {
									"cook:bread": 3
								}
							}
						]
					}
				]
			}
		}
	}
}